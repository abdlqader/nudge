    "definitions": {
        "handlers.CreateTaskRequest": {
            "type": "object",
            "required": [
                "name",
                "task_category"
            ],
            "properties": {
                "actual_duration": {
                    "type": "integer",
                    "maximum": 1440,
                    "minimum": 1
                },
                "actual_units": {
                    "type": "integer",
                    "minimum": 0
                },
                "category": {
                    "type": "string"
                },
                "deadline": {
                    "description": "ISO 8601 format",
                    "type": "string"
                },
                "expected_duration": {
                    "type": "integer",
                    "maximum": 1440,
                    "minimum": 1
                },
                "expected_units": {
                    "type": "integer",
                    "maximum": 1000,
                    "minimum": 1
                },
                "name": {
                    "type": "string"
                },
                "notes": {
                    "type": "string"
                },
                "start_at": {
                    "type": "integer",
                    "maximum": 1439,
                    "minimum": 0
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "CREATED",
                        "COMPLETED",
                        "FAILED",
                        "DEFERRED"
                    ]
                },
                "task_category": {
                    "type": "string",
                    "enum": [
                        "ACTION",
                        "ANCHOR",
                        "TRANSIT"
                    ]
                }
            }
        },
        "handlers.LoginRequest": {
            "type": "object",
            "required": [
                "email",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "handlers.LoginResponse": {
            "type": "object",
            "properties": {
                "token": {
                    "type": "string"
                },
                "user": {
                    "$ref": "#/definitions/handlers.UserResponse"
                }
            }
        },
        "handlers.RegisterRequest": {
            "type": "object",
            "required": [
                "email",
                "first_name",
                "last_name",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "first_name": {
                    "type": "string"
                },
                "last_name": {
                    "type": "string"
                },
                "password": {
                    "type": "string",
                    "minLength": 6
                }
            }
        },
        "handlers.UpdateTaskRequest": {
            "type": "object",
            "properties": {
                "actual_duration": {
                    "type": "integer",
                    "maximum": 1440,
                    "minimum": 1
                },
                "actual_units": {
                    "type": "integer",
                    "minimum": 0
                },
                "category": {
                    "type": "string"
                },
                "deadline": {
                    "description": "ISO 8601 format, empty string to clear",
                    "type": "string"
                },
                "expected_duration": {
                    "type": "integer",
                    "maximum": 1440,
                    "minimum": 1
                },
                "expected_units": {
                    "type": "integer",
                    "maximum": 1000,
                    "minimum": 1
                },
                "name": {
                    "type": "string"
                },
                "notes": {
                    "type": "string"
                },
                "start_at": {
                    "type": "integer",
                    "maximum": 1439,
                    "minimum": 0
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "CREATED",
                        "COMPLETED",
                        "FAILED",
                        "DEFERRED"
                    ]
                },
                "task_category": {
                    "type": "string",
                    "enum": [
                        "ACTION",
                        "ANCHOR",
                        "TRANSIT"
                    ]
                }
            }
        },
        "handlers.UserResponse": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string"
                },
                "first_name": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "last_name": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "JWT bearer token. Format: \"Bearer \u003ctoken\u003e\"",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}